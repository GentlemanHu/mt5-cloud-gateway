# ==============================================================================
# MetaTrader 5 Cloud Gateway & MCP Server - Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway Server Network Settings / 网关网络配置
# ------------------------------------------------------------------------------
# Listening interface (0.0.0.0 for all interfaces, 127.0.0.1 for local only)
MT5_HOST=0.0.0.0

# HTTP & REST / SSE / MCP Service Port (Default: 18812)
MT5_HTTP_PORT=18812

# RFC 6455 Native WebSocket Market Stream Port (Default: 18813)
MT5_WS_PORT=18813

# Public domain or URL when accessed behind a proxy/tunnel (e.g., https://trade.yourdomain.com)
# Leave empty to automatically detect from incoming HTTP Host headers.
PUBLIC_GATEWAY_URL=

# ------------------------------------------------------------------------------
# 2. Web Management Panel Security / 管理面板安全配置
# ------------------------------------------------------------------------------
# Master password to access the Web Control Panel (/ or /dashboard)
# Global login requires this password; Bearer API tokens are decoupled from this.
MT5_PANEL_PASSWORD=admin123456

# ------------------------------------------------------------------------------
# 3. MetaTrader 5 Terminal Configuration (Optional / 可选配置)
# ------------------------------------------------------------------------------
# If left empty, the gateway connects to the currently active MetaTrader 5 terminal
# without overriding the existing terminal account credentials.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Custom path to terminal64.exe (Optional, auto-detected in standard paths if blank)
# e.g.: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# ------------------------------------------------------------------------------
# 4. Cloudflare Tunnel Settings (Optional / 可选外网穿透配置)
# ------------------------------------------------------------------------------
# If you want to expose your gateway securely over Cloudflare without public IPv4/IPv6:
# Paste your Cloudflare Tunnel Token here.
# If left empty, the gateway runs in pure local/LAN network mode.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Hostname routed to this tunnel (e.g. trading.yourdomain.com)
CLOUDFLARE_HOSTNAME=
